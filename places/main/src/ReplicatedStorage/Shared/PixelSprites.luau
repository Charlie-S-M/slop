const GUN_SPRITES: { [string]: string } = {
	Pistol = "Pistol",
	SMG = "SMG",
	Burst = "SMG",
	Rifle = "Rifle",
	Sniper = "Rifle",
	Shotgun = "Shotgun",
	Minigun = "Heavy",
	Launcher = "Heavy",
}

function PixelSprites.forGun(kind: string): string
	return GUN_SPRITES[kind] or "Pistol"
end

function PixelSprites.forArmor(slot: string): string
	return if PixelSprites.SPRITES[slot] then slot else "Chestplate"
end

function PixelSprites.forPet(style: string): string
	return if style == "Bird" or style == "Dragon" then "Winged" else "Critter"
end

-- Each row's stretches of one key, so an icon draws as a few frames instead of 256 pixels.
function PixelSprites.runs(rows: { string }): { Run }
	local found: { Run } = {}
	for y, row in rows do
		local x = 1
		while x <= #row do
			local key = string.sub(row, x, x)
			local width = 1
			while x + width <= #row and string.sub(row, x + width, x + width) == key do
				width += 1
			end
			if key ~= "." then
				table.insert(found, { x = x - 1, y = y - 1, width = width, key = key })
			end
			x += width
		end
	end
	return found
end

local cached: { [string]: { Run } } = {}
local oreIcons =
	{ Rock = "Stone", Metal = "Ingot", Gem = "Gem", Crystal = "Shard", Core = "CoreIcon" }
function PixelSprites.forOre(style: string): string
	return (oreIcons :: { [string]: string })[style] or "Gem"
end

-- A left-right mirror of a sprite, registered under `<key>Flip` the first time it's asked for.
function PixelSprites.flipped(key: string): string
	local flip = key .. "Flip"
	if not PixelSprites.SPRITES[flip] then
		local rows = {}
		for index, row in PixelSprites.SPRITES[key] do
			rows[index] = string.reverse(row)
		end
		PixelSprites.SPRITES[flip] = rows
	end
	return flip
end

function PixelSprites.draw(
	parent: Instance,
	key: string,
	body: Color3,
	accent: Color3,
	trim: Color3?
)
	local ink = Color3.fromRGB(28, 21, 42)
	local palette: { [string]: Color3 } = {
		k = ink,
		b = body,
		a = accent,
		t = trim or body:Lerp(ink, 0.52),
		w = accent:Lerp(Color3.new(1, 1, 1), 0.72),
	}
	local runs = cached[key] or PixelSprites.runs(PixelSprites.SPRITES[key])
	cached[key] = runs
	for _, strip in runs do
		local pixel = Instance.new("Frame")
		pixel.BorderSizePixel = 0
		pixel.BackgroundColor3 = palette[strip.key]
		pixel.Size = UDim2.fromScale(strip.width / 16, 1 / 16)
		pixel.Position = UDim2.fromScale(strip.x / 16, strip.y / 16)
		pixel.Parent = parent
	end
end

return PixelSprites
